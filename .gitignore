.venv/
.venv-*/
# `models` e symlink para ~/ai/hf (HF_HOME unico da maquina); `models/` com
# barra so casa diretorio, e o symlink aparecia como nao rastreado.
/models
cache/
projects/
books/
bench/out*/
bench/*.log
__pycache__/
*.egg-info/

# NUNCA versionar vozes de referencia (TDD secao 15)
voices/

# Acervo do canal, fora do git de proposito: sao 25 MB de imagem
# (assets/slides, 52 JPEG) e ~100 MB de musica (assets/musica, as pecas
# aprovadas do ACE-Step). Binario grande entra no historico para sempre e nao ha
# por que carregar isso num clone. Origem e licenca em LICENSES.md.
#
# Sem assets/slides, use --preset gradiente ou --slides-dir. Sem assets/musica,
# o `video` regenera as pecas na primeira vez -- a seed sai da paleta, entao
# elas voltam identicas, so custam GPU.
assets/

# Takes soltos na raiz, de teste manual
/*.wav

# Credenciais OAuth do YouTube (Data API v3) -- nunca versionar
config/youtube_client_secret.json
config/youtube_token*
config/youtube_canal_token*

# Permissoes pessoais do Claude Code (nao e config de time)
.claude/settings.local.json

# Guarda contra binario pesado em qualquer pasta (spikes/, tests/, docs/...):
# pesos, midia e saidas geradas vivem em ~/ai, assets/, cache/ e projects/.
# Excecao pontual: `git add -f`, ou um `!caminho` abaixo com o motivo.
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.onnx
*.bin
*.wav
*.flac
*.mp3
*.aac
*.m4a
*.mp4
*.mkv
*.webm
*.png
*.jpg
*.jpeg
*.webp
*.cbz
*.db
*.sqlite
*.sqlite3

# Configuracao local da maquina (modelo versionado: vf.example.toml)
/vf.toml
